if BOOTLINUX_CLOUD_BUILD

config TERRAFORM_GCE_CLOUD_BUILD_BUCKET
	string "GCS bucket name for kernel artifacts"
	output yaml
	default ""
	help
	  Name of the GCS bucket where Cloud Build stores kernel
	  artifacts. If left empty, a bucket name is generated from
	  the project ID with a random suffix to ensure uniqueness.

config TERRAFORM_GCE_CLOUD_BUILD_RETENTION_DAYS
	int "Artifact retention period (days)"
	output yaml
	default 30
	help
	  Number of days to retain kernel artifacts in the GCS
	  bucket before automatic deletion. Older artifacts are
	  cleaned up to manage storage costs.

choice
	prompt "Cloud Build machine type"
	default TERRAFORM_GCE_CLOUD_BUILD_MACHINE_E2_HIGHCPU_8
	help
	  Machine type for Cloud Build workers. Larger machines
	  reduce build time but increase cost.

config TERRAFORM_GCE_CLOUD_BUILD_MACHINE_E2_MEDIUM
	bool "E2_MEDIUM"
	help
	  E2 machine with 1 vCPU and 4GB memory. Lowest cost option,
	  suitable for small builds.

config TERRAFORM_GCE_CLOUD_BUILD_MACHINE_E2_HIGHCPU_8
	bool "E2_HIGHCPU_8"
	help
	  E2 high-CPU machine with 8 vCPUs and 8GB memory. Good
	  balance of cost and performance for kernel builds.

config TERRAFORM_GCE_CLOUD_BUILD_MACHINE_E2_HIGHCPU_32
	bool "E2_HIGHCPU_32"
	help
	  E2 high-CPU machine with 32 vCPUs and 32GB memory. Faster
	  builds at higher cost.

config TERRAFORM_GCE_CLOUD_BUILD_MACHINE_N1_HIGHCPU_8
	bool "N1_HIGHCPU_8"
	help
	  N1 high-CPU machine with 8 vCPUs and 7.2GB memory.

config TERRAFORM_GCE_CLOUD_BUILD_MACHINE_N1_HIGHCPU_32
	bool "N1_HIGHCPU_32"
	help
	  N1 high-CPU machine with 32 vCPUs and 28.8GB memory.
	  Fastest builds at highest cost.

endchoice

config TERRAFORM_GCE_CLOUD_BUILD_MACHINE_TYPE
	string
	output yaml
	default "E2_MEDIUM" if TERRAFORM_GCE_CLOUD_BUILD_MACHINE_E2_MEDIUM
	default "E2_HIGHCPU_8" if TERRAFORM_GCE_CLOUD_BUILD_MACHINE_E2_HIGHCPU_8
	default "E2_HIGHCPU_32" if TERRAFORM_GCE_CLOUD_BUILD_MACHINE_E2_HIGHCPU_32
	default "N1_HIGHCPU_8" if TERRAFORM_GCE_CLOUD_BUILD_MACHINE_N1_HIGHCPU_8
	default "N1_HIGHCPU_32" if TERRAFORM_GCE_CLOUD_BUILD_MACHINE_N1_HIGHCPU_32

config TERRAFORM_GCE_CLOUD_BUILD_SERVICE_ACCOUNT_ID
	string "Service account ID"
	output yaml
	default "kdevops-cloud-build"
	help
	  ID for the GCE service account created to run Cloud Build
	  operations. The ID must be 6-30 characters using lowercase
	  letters, numbers, and dashes. Terraform provisions this
	  account with permissions to access the artifact bucket and
	  submit builds. See the GCE documentation for details:

	  https://cloud.google.com/iam/docs/service-accounts-create

config TERRAFORM_GCE_CLOUD_BUILD_PRESERVE_ARTIFACTS
	bool "Preserve artifacts on destroy"
	output yaml
	default n
	help
	  When enabled, the artifact bucket is removed from Terraform
	  state before destroy. This allows destroy to complete while
	  leaving the bucket and its kernel packages intact in GCS for
	  later use or manual cleanup.

	  When disabled (the default), all resources are released on
	  destroy, including any stored artifacts. This matches the
	  behavior of other build modes and avoids accruing storage
	  costs after teardown.

endif # BOOTLINUX_CLOUD_BUILD
