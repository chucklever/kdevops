# GCE Cloud Build configuration for Linux kernel builds
# Generated by kdevops - do not edit manually
#
# This configuration clones the kernel source, builds kernel packages,
# and uploads them to GCS for installation on target nodes.

steps:
  # Clone kernel source
  - name: 'gcr.io/cloud-builders/git'
    entrypoint: 'bash'
    args:
      - '-c'
      - |
        set -ex
{% if target_linux_shallow_depth | default(0) | int > 0 %}
        # Shallow clone using fetch to handle both branch/tag names and commit SHAs.
        # The --branch flag only accepts branches or tags, not arbitrary commits,
        # so we initialize, add remote, and fetch the specific ref instead.
        git init /workspace/linux
        cd /workspace/linux
        git remote add origin {{ target_linux_git }}
        git fetch --depth {{ target_linux_shallow_depth }} origin {{ target_linux_ref }}
        git checkout FETCH_HEAD
{% else %}
        git clone {{ target_linux_git }} /workspace/linux
        cd /workspace/linux
        git checkout {{ target_linux_ref }}
{% endif %}
    id: 'clone'

  # Build kernel packages
  - name: 'gcr.io/cloud-builders/docker'
    entrypoint: 'bash'
    args:
      - '-c'
      - |
        set -ex
        mkdir -p /workspace/artifacts

        # Run build in a container with build dependencies
        docker run --rm \
          -v /workspace/linux:/linux \
          -v /workspace/artifacts:/artifacts \
          -w /linux \
{% if ansible_os_family | default('RedHat') == 'Debian' %}
          debian:bookworm \
{% else %}
          fedora:latest \
{% endif %}
          /bin/bash -c '
            set -ex

{% if ansible_os_family | default('RedHat') == 'Debian' %}
            # Install build dependencies for Debian/Ubuntu
            apt-get update
            apt-get install -y --no-install-recommends \
              build-essential bc bison flex libelf-dev libssl-dev \
              kmod cpio rsync

            # Configure and build
            make -j$(nproc) olddefconfig
            make -j$(nproc) bindeb-pkg LOCALVERSION=""

            # Move packages to artifacts
            mv /linux/../*.deb /artifacts/ || true
{% else %}
            # Install build dependencies for Fedora/RHEL
            dnf install -y \
              make gcc flex bison openssl-devel elfutils-libelf-devel \
              bc perl rpm-build rsync

            # Configure and build
            make -j$(nproc) olddefconfig
            make -j$(nproc) binrpm-pkg LOCALVERSION=""

            # Move packages to artifacts
            find /linux/rpmbuild/RPMS -name "*.rpm" -exec mv {} /artifacts/ \; || true
{% endif %}

            # Save kernel release for later use
            make kernelrelease > /artifacts/kernel.release
          '
    id: 'build'
    waitFor: ['clone']

# Upload artifacts to GCS
artifacts:
  objects:
    location: 'gs://{{ cloud_build_bucket }}/{{ cloud_build_artifact_prefix }}/'
    paths:
      - '/workspace/artifacts/*'

options:
  machineType: '{{ terraform_gce_machine_type | default("e2-highcpu-32") }}'
  diskSizeGb: 100
  logging: CLOUD_LOGGING_ONLY

timeout: '{{ bootlinux_cloud_build_timeout_minutes | default(60) * 60 }}s'
